node_modules/
admin-ui/node_modules/
admin-ui/.astro/
# admin-ui/dist is rebuilt inside the image by the admin-ui stage.
admin-ui/dist/
vendor/
.git/
.gitignore
*.md
tests/
coverage/
.phpunit.cache/
.phpunit.result.cache
.DS_Store

# Tooling and agent scratch, none of it application code. .claude in particular
# holds agent worktrees with their own node_modules — well over a gigabyte — so
# leaving it in the build context both bloats the image and, when chown -R walks
# it, fills the build disk. That is a real build failure, not just waste.
.claude/
.github/
.roady/

# The headless demo (a separate front end + its own compose stack) is not part
# of the CMS image — it has its own build. Excluding it keeps the CMS image lean
# and out of the front end's node_modules.
demo/

# Runtime state. Mounted as volumes at run time, so baking a build machine's
# content and users into the image would ship one person's data to every deploy.
content/
data/

# Local environment and build definitions.
.env
.env.*
*.log
Dockerfile
.dockerignore
docker-compose*.yml

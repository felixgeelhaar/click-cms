RewriteEngine On

# Apache serves the built admin shell before PHP sees /admin/. Keep that HTML
# fresh so logout or an account switch cannot leave a shared browser cache with
# a prior session's UI response. Ordinary JS, CSS, images and public pages keep
# their existing cache behavior.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "(^|/)admin(/|$)" CLICK_ADMIN_HTML_REQUEST
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header always set Cache-Control "no-store, private" env=CLICK_ADMIN_HTML_REQUEST
    </FilesMatch>
</IfModule>

# Installed in a subdirectory? Uncomment this and name the URL path the site
# answers on, with a trailing slash — `RewriteBase /2026/cms/`.
#
# Apache is supposed to work this out from the directory the .htaccess is in,
# and on many servers it does. On others — shared hosting especially — the
# substitution below is resolved against the document root instead, and every
# clean URL 404s while `index.php/api/pages` works perfectly. That combination
# is the symptom; this line is the cure.
#
# RewriteBase /

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

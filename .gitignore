# Secrets
config/marketplace-private.pem
*.pem

# Dependencies
node_modules/
vendor/

# Build outputs
admin-ui/dist/
admin-ui/.astro/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data & Content
#
# Anchored with a leading slash so these match ONLY the runtime directories at
# the repository root. Unanchored, Git applies them at every depth, which
# silently excluded src/Domain/Content, src/Application/Content,
# src/Domain/Storage and src/Infrastructure/Storage from every commit.
/data/
/content/
/storage/
# Every other site's content and data, on an installation that serves more than
# one. `config/sites.json` is deliberately NOT ignored: which sites exist and
# which hostnames they answer for is deployment configuration and belongs in a
# diff, unlike the content itself.
/sites/
*.sqlite
*.sqlite3

# PHP
.phpunit.result.cache
# PHPUnit 10+ writes a cache directory, not the old single file.
.phpunit.cache/

# Test coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Marketplace registry (separate repo)
marketplace-registry/

# Roady project management
.roady/

# Agent worktrees and local session state.
.claude/

# Headless demo — generated/runtime bits (source, compose and seed are tracked).
# Customer material does not belong in this repository. The demo directory is
# scratch for building a real site with this CMS, and what comes out of it —
# screenshots of someone's admin, a guide written for a named person — is
# theirs, not an example. Ignored so it cannot be added back by a wide `git add`.
demo/state/
docs/turboscience-demo/
demo/turboscience-web/node_modules/
demo/turboscience-web/dist/
demo/turboscience-web/package-lock.json

# Local demos — never committed.
demo/
docker-compose.turboscience.yml

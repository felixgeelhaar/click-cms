# Data & Content
#
# Anchored with a leading slash so these match ONLY the runtime directories at
# the repository root. Unanchored, Git applies them at every depth, which
# silently excluded src/Domain/Content, src/Application/Content,
# src/Domain/Storage and src/Infrastructure/Storage from every commit.
/data/
/content/
/storage/
*.sqlite
*.sqlite3

# PHP
.phpunit.result.cache
# PHPUnit 10+ writes a cache directory, not the old single file.
.phpunit.cache/

# Test coverage
coverage/

# OS
.DS_Store
Thumbs.db

# Marketplace registry (separate repo)
marketplace-registry/

# Roady project management
.roady/

# Agent worktrees and local session state.
.claude/

# Headless demo — generated/runtime bits (source, compose and seed are tracked).
demo/state/
demo/turboscience-web/node_modules/
demo/turboscience-web/dist/
demo/turboscience-web/package-lock.json

# Local demos — never committed.
demo/
docker-compose.turboscience.yml

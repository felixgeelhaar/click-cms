<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         testdox="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <!--
        Deliberately no coverage block here. Declaring a coverage report in this
        file makes PHPUnit 13 execute nothing at all when no coverage driver
        (Xdebug/PCOV) is installed: it fails silently with "No tests executed",
        which is how this suite went unnoticed. Generate coverage on demand from
        the command line instead, passing the coverage-html flag with an output
        directory.
    -->
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
